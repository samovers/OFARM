{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/operation-intent/v0.1",
  "title": "Complete typed operation assertion intent candidate",
  "$comment": "DRAFT_NON_DEFAULT domain construction input. New body/subject schema selection only; existing action, resource extraction, scope and effect-subject semantics remain unchanged. No rule adoption, authorization eligibility, approval mode or runtime activation is established. The complete local schema closure must be independently pinned by the domain package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resources",
    "effectSubject",
    "subject",
    "assertedAt",
    "assertionActPosture",
    "subjectTime",
    "assertionBody",
    "evidenceBindings",
    "claimPosture",
    "performedByPartyRef"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ofarm.operationassertioneffectintent.typed.v0.1"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "$ref": "#/$defs/targetScope"
        }
      ],
      "items": false
    },
    "effectSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectKind",
        "subjectRef",
        "existencePosture",
        "effectSubjectProofBindings"
      ],
      "properties": {
        "subjectKind": {
          "const": "OPERATION_ASSERTION"
        },
        "subjectRef": {
          "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/logicalRef"
        },
        "existencePosture": {
          "const": "PROSPECTIVE_TARGET_ALLOWED"
        },
        "effectSubjectProofBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/immutableBinding"
          }
        }
      }
    },
    "subject": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/subject"
    },
    "assertedAt": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/canonicalTimestamp",
      "$comment": "Trusted online injection or resolved immutable offline evidence, before validation/digest. JSON Schema validates shape, not origin."
    },
    "assertionActPosture": {
      "enum": [
        "TRUSTED_ONLINE_SUBMISSION",
        "VERIFIED_OFFLINE_SUBMISSION"
      ]
    },
    "assertionActEvidenceBinding": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/immutableBinding"
    },
    "subjectTime": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/operationTime"
    },
    "assertionBody": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/operationClaimBody"
    },
    "evidenceBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/immutableBinding"
      }
    },
    "subjectScopeProofBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/immutableBinding"
      }
    },
    "claimPosture": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/operationClaimContext/properties/claimPosture"
    },
    "performedByPartyRef": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/operationClaimContext/properties/performedByPartyRef"
    },
    "softwareAgentActorshipBindings": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/operationClaimContext/properties/softwareAgentActorshipBindings"
    },
    "performerAuthorityEvidenceBindings": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/operationClaimContext/properties/performerAuthorityEvidenceBindings"
    },
    "supersedesAssertionRecordBinding": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/immutableBinding"
    },
    "associatedSemanticEventBinding": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/immutableBinding",
      "$comment": "Exact PR23 §7.3 binding shape only; foreign Event Ingress and domain compatibility are separately required. Never derive event family here."
    },
    "authorizationUsePurpose": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}(?![\\s\\S])"
    },
    "scopeProofBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/immutableBinding"
      }
    },
    "dataSovereigntyBoundaryBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/immutableBinding"
      }
    }
  },
  "$defs": {
    "targetScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceRole",
        "resourcePosture",
        "targetType",
        "scope",
        "tenantRef",
        "authorizationResourceProofBindings"
      ],
      "properties": {
        "resourceRole": {
          "const": "TARGET_SCOPE"
        },
        "resourcePosture": {
          "const": "AUTHORITY_TARGET"
        },
        "targetType": {
          "const": "SCOPE"
        },
        "scope": {
          "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/anchorScope"
        },
        "tenantRef": {
          "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/logicalRef"
        },
        "twin": {
          "enum": [
            "COMPLIANCE",
            "ADVISORY"
          ],
          "$comment": "Encoding only. Governed immutable resource/context proof determines applicability. Omission is not a claim of NOT_APPLICABLE."
        },
        "authorizationResourceProofBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "assertionActPosture"
        ],
        "properties": {
          "assertionActPosture": {
            "const": "VERIFIED_OFFLINE_SUBMISSION"
          }
        }
      },
      "then": {
        "required": [
          "assertionActEvidenceBinding"
        ]
      },
      "else": {
        "properties": {
          "assertionActEvidenceBinding": false
        }
      }
    },
    {
      "if": {
        "required": [
          "assertionBody"
        ],
        "properties": {
          "assertionBody": {
            "required": [
              "assertionPosture"
            ],
            "properties": {
              "assertionPosture": {
                "const": "CORRECTION"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "supersedesAssertionRecordBinding"
        ]
      },
      "else": {
        "properties": {
          "supersedesAssertionRecordBinding": false
        }
      }
    },
    {
      "if": {
        "required": [
          "subject"
        ],
        "properties": {
          "subject": {
            "required": [
              "subjectPosture"
            ],
            "properties": {
              "subjectPosture": {
                "const": "PROSPECTIVE_SUBJECT"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "subjectScopeProofBindings"
        ]
      }
    },
    {
      "if": {
        "required": [
          "claimPosture"
        ],
        "properties": {
          "claimPosture": {
            "const": "INTENDED"
          }
        }
      },
      "then": {
        "properties": {
          "subjectTime": {
            "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/INTENDED_WINDOW"
          },
          "assertionBody": {
            "properties": {
              "temporalBasis": {
                "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/intendedTimeBasis"
              },
              "allegesSoftwareAgentPerformance": {
                "const": false
              }
            }
          },
          "softwareAgentActorshipBindings": false,
          "performerAuthorityEvidenceBindings": false,
          "associatedSemanticEventBinding": false
        }
      },
      "else": {
        "properties": {
          "subjectTime": {
            "oneOf": [
              {
                "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/PERFORMED_INSTANT"
              },
              {
                "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/PERFORMED_INTERVAL"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "assertionBody"
        ],
        "properties": {
          "assertionBody": {
            "required": [
              "allegesSoftwareAgentPerformance"
            ],
            "properties": {
              "allegesSoftwareAgentPerformance": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "softwareAgentActorshipBindings"
        ],
        "properties": {
          "claimPosture": {
            "const": "PERFORMED"
          }
        }
      },
      "else": {
        "properties": {
          "softwareAgentActorshipBindings": false
        }
      }
    },
    {
      "if": {
        "required": [
          "subjectTime"
        ],
        "properties": {
          "subjectTime": {
            "required": [
              "profile"
            ],
            "properties": {
              "profile": {
                "const": "PERFORMED_INSTANT"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assertionBody": {
            "properties": {
              "temporalBasis": {
                "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/performedInstantEvidenceBasis"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "subjectTime"
        ],
        "properties": {
          "subjectTime": {
            "required": [
              "profile"
            ],
            "properties": {
              "profile": {
                "const": "PERFORMED_INTERVAL"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "assertionBody": {
            "properties": {
              "temporalBasis": {
                "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/result/v0.1#/$defs/performedIntervalBasis"
              }
            }
          }
        }
      }
    }
  ]
}
