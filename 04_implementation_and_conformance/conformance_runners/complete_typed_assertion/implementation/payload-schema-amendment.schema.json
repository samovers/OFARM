            "unresolvedSelections": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "EVENT_ENVELOPE_DIGEST",
                  "EVENT_MEANING_CASE_DEFINITION"
                ]
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "disposition": {
                    "const": "PASS"
                  }
                }
              },
              "then": {
                "required": [
                  "envelope",
                  "caseDefinitionBinding"
                ],
                "not": {
                  "required": [
                    "unresolvedSelections"
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "envelope",
                  "caseDefinitionBinding"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "unresolvedSelections"
                  ]
                }
              },
              "else": {
                "required": [
                  "unresolvedSelections"
                ],
                "properties": {
                  "disposition": {
                    "enum": [
                      "FAIL",
                      "NOT_EVALUATED"
                    ]
                  },
                  "failedPrerequisites": {
                    "minItems": 1
                  },
                  "diagnostics": {
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "not": {
                  "required": [
                    "envelope"
                  ]
                }
              },
              "then": {
                "properties": {
                  "unresolvedSelections": {
                    "contains": {
                      "const": "EVENT_ENVELOPE_DIGEST"
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "unresolvedSelections": {
                    "not": {
                      "contains": {
                        "const": "EVENT_ENVELOPE_DIGEST"
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "not": {
                  "required": [
                    "caseDefinitionBinding"
                  ]
                }
              },
              "then": {
                "properties": {
                  "unresolvedSelections": {
                    "contains": {
                      "const": "EVENT_MEANING_CASE_DEFINITION"
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "unresolvedSelections": {
                    "not": {
                      "contains": {
                        "const": "EVENT_MEANING_CASE_DEFINITION"
                      }
                    }
                  }
                }
              }
            }
          ],
          "$comment": "Retain the submitted immutable event selector exactly. A missing envelope digest or meaning-case definition is explicit in a FAIL/NOT_EVALUATED payload, never replaced by a fabricated binding. PASS retains both resolved fields."
        }
