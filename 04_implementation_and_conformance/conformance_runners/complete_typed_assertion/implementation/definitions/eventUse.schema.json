{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofarm.dev/schema/drafts/non-default/assertion-domain/event-use-definition/v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "ofarm.assertionDomainEventUseDefinition.v0.1"
    },
    "definitionId": {
      "type": "string",
      "minLength": 1
    },
    "envelopeBinding": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/payload/v0.1#/$defs/immutableBinding"
    },
    "canonicalCaseBinding": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/payload/v0.1#/$defs/immutableBinding"
    },
    "subtypePresence": {
      "enum": [
        "PRESENT",
        "ABSENT"
      ]
    },
    "vocabularyDefinitionBinding": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/payload/v0.1#/$defs/immutableBinding"
    },
    "packDefinitionBinding": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/payload/v0.1#/$defs/immutableBinding"
    },
    "observationMeasurementBinding": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/payload/v0.1#/$defs/immutableBinding"
    },
    "extentTemporalMeanings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "extentBinding": {
            "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/payload/v0.1#/$defs/immutableBinding"
          },
          "sourceTimeType": {
            "enum": [
              "INTERVAL",
              "OPEN_INTERVAL"
            ]
          },
          "timeBasis": {
            "type": "string",
            "minLength": 1
          },
          "startBoundary": {
            "enum": [
              "INCLUSIVE",
              "EXCLUSIVE"
            ]
          },
          "endBoundary": {
            "enum": [
              "INCLUSIVE",
              "EXCLUSIVE",
              "UNBOUNDED"
            ]
          }
        },
        "required": [
          "extentBinding",
          "sourceTimeType",
          "timeBasis",
          "startBoundary",
          "endBoundary"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "definitionId",
    "envelopeBinding",
    "canonicalCaseBinding",
    "subtypePresence",
    "vocabularyDefinitionBinding",
    "packDefinitionBinding"
  ],
  "$comment": "New domain-owned normative input. Exact independent selection and protected original bytes are required. No source admission, authority, runtime producer or statutory applicability is asserted."
}
