    {
      "if": {
        "required": [
          "splitCountPopulation"
        ]
      },
      "then": {
        "properties": {
          "category": {
            "const": "OBSERVED_PROPERTY"
          },
          "workConditionMeaning": {
            "properties": {
              "activityRow": {
                "const": "O11"
              },
              "stage": {
                "const": "FINISH"
              }
            }
          }
        },
        "required": [
          "workConditionMeaning"
        ]
      }
    },
    {
