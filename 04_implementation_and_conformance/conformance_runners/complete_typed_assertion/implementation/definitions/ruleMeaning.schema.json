{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofarm.dev/schema/drafts/non-default/assertion-domain/compliance-rule-meaning-definition/v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "ofarm.assertionDomainComplianceRuleMeaningDefinition.v0.1"
    },
    "definitionId": {
      "type": "string",
      "minLength": 1
    },
    "ruleBinding": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/payload/v0.1#/$defs/immutableBinding"
    },
    "relevanceRoles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "basisKind": {
            "enum": [
              "MEASUREMENT_ABOUT_SUBJECT",
              "EVENT_ABOUT_SUBJECT"
            ]
          },
          "eventConcept": {
            "const": "HAIL_DAMAGE_OCCURRENCE"
          }
        },
        "required": [
          "role",
          "basisKind"
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "eventConcept"
              ]
            },
            "then": {
              "properties": {
                "basisKind": {
                  "const": "EVENT_ABOUT_SUBJECT"
                }
              }
            }
          }
        ]
      }
    },
    "applicabilityClauses": {
      "type": "array",
      "$comment": "Closed valid-time bounds, null upper bound unbounded; the entire claimed period must be covered. No match means INDETERMINATE, and multiple matching clauses are ambiguous.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "clauseId": {
            "type": "string",
            "minLength": 1
          },
          "jurisdiction": {
            "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-domain/proposition/v0.1#/$defs/C02/properties/body/properties/jurisdiction"
          },
          "cropBinding": {
            "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/payload/v0.1#/$defs/immutableBinding"
          },
          "useBinding": {
            "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/payload/v0.1#/$defs/immutableBinding"
          },
          "subjectKinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-domain/proposition/v0.1#/$defs/C02/properties/scope/properties/subject/allOf/1/properties/subjectType"
            }
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "effect": {
            "enum": [
              "APPLIES",
              "DOES_NOT_APPLY"
            ]
          }
        },
        "required": [
          "clauseId",
          "jurisdiction",
          "cropBinding",
          "useBinding",
          "subjectKinds",
          "validFrom",
          "validUntil",
          "effect"
        ]
      }
    },
    "interpretationScope": {
      "const": "CONDITIONAL_DOMAIN_MEANING_ONLY"
    }
  },
  "required": [
    "schemaVersion",
    "definitionId",
    "ruleBinding",
    "relevanceRoles",
    "applicabilityClauses",
    "interpretationScope"
  ],
  "$comment": "New domain-owned normative input. Exact independent selection and protected original bytes are required. No source admission, authority, runtime producer or statutory applicability is asserted."
}
