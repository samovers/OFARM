{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofarm.dev/schema/drafts/non-default/assertion-domain/analysis-output-specification/v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "ofarm.assertionDomainAnalysisOutputSpecification.v0.1"
    },
    "definitionId": {
      "type": "string",
      "minLength": 1
    },
    "activityRow": {
      "const": "O22"
    },
    "workSpecificationBinding": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/payload/v0.1#/$defs/immutableBinding"
    },
    "procedureBinding": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/payload/v0.1#/$defs/immutableBinding"
    },
    "sampleBinding": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/payload/v0.1#/$defs/immutableBinding"
    },
    "propertyBinding": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/payload/v0.1#/$defs/immutableBinding"
    },
    "methodBinding": {
      "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/payload/v0.1#/$defs/immutableBinding"
    },
    "sampleTargetRelationProofBindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/payload/v0.1#/$defs/immutableBinding"
      }
    },
    "sampleTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "FIELD",
            "ZONE",
            "CROP_CYCLE",
            "LOT",
            "PARTIAL_EXTENT"
          ]
        },
        "binding": {
          "$ref": "https://ofarm.dev/schema/drafts/non-default/assertion-record-domain-validation/payload/v0.1#/$defs/immutableBinding"
        }
      },
      "required": [
        "kind",
        "binding"
      ]
    },
    "methodVersionRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$",
      "$comment": "Expected original procedure version; not the selected meaning definition revision or digest."
    },
    "permittedResultKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "NUMERIC",
          "CODED",
          "QUALITATIVE",
          "CENSORED_NUMERIC"
        ]
      }
    },
    "quantityContext": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quantityKind": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "quantityKind",
            "unit"
          ]
        }
      ]
    },
    "productionTimeRule": {
      "const": "RESULT_TIME_WITHIN_CLAIMED_WORK_TIME"
    },
    "interpretationScope": {
      "const": "REPORTED_OUTPUT_EXISTENCE_NOT_RESULT_TRUTH_OR_ADMISSION"
    }
  },
  "required": [
    "schemaVersion",
    "definitionId",
    "activityRow",
    "workSpecificationBinding",
    "procedureBinding",
    "sampleBinding",
    "propertyBinding",
    "methodBinding",
    "permittedResultKinds",
    "quantityContext",
    "productionTimeRule",
    "interpretationScope"
  ],
  "$comment": "New domain-owned normative input. Exact independent selection and protected original bytes are required. No source admission, authority, runtime producer or statutory applicability is asserted.",
  "allOf": [
    {
      "if": {
        "required": [
          "sampleTargetRelationProofBindings"
        ]
      },
      "then": {
        "required": [
          "sampleTarget"
        ]
      }
    }
  ]
}
