{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofarm.dev/schema/drafts/non-default/protected-state-evidence/selection/v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractRawSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contextRawSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policyRawSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proofBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "ref",
        "digest"
      ]
    }
  },
  "required": [
    "contractRawSha256",
    "contextRawSha256",
    "policyRawSha256",
    "proofBinding"
  ]
}
