              "snapshotVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "observedVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "key",
              "role",
              "binding",
              "rawSha256",
              "availability",
              "digestMode",
              "observedVersion"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "availability": {
                      "const": "FIXED_BEFORE_DOMAIN_VERDICT"
                    }
                  }
                },
                "then": {
                  "required": [
                    "fixedInputVersion"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "fixedInputVersion"
                    ]
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "digestMode"
                  ],
                  "properties": {
                    "digestMode": {
                      "const": "RAW_BYTES"
                    }
