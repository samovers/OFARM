              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "scopeType",
              "scopeRef"
            ],
            "not": {
              "required": [
                "revisionRef",
                "digest"
              ]
            }
          },
          "minItems": 1,
          "maxItems": 4096
        },
        "priorCreationKind": {
          "enum": [
            "PRIOR_GOVERNED_RECEIPT",
            "LEGACY_IMMUTABLE_INGRESS"
          ]
        }
      },
      "required": [
        "snapshotBinding",
        "proposedResult",
        "readBindings"
      ]
    }
