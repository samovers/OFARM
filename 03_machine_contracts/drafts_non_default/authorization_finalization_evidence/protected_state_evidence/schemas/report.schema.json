          "required": [
            "boundaryKind",
            "boundaryRef",
            "twin"
          ]
        },
        "priorRecordedAnchorScopes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scopeType": {
                "enum": [
                  "FARM",
                  "SITE",
                  "FIELD",
                  "ZONE",
                  "CROP_CYCLE",
                  "LOT",
                  "FACILITY",
                  "OPERATION",
                  "DEPLOYMENT",
                  "TENANT"
