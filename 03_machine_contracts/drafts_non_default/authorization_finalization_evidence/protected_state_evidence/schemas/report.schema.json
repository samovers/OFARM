                },
                "then": {
                  "properties": {
                    "binding": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "ref": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        "revisionRef": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        }
                      },
                      "required": [
                        "ref"
                      ]
                    },
                    "role": {
                      "not": {
                        "enum": [
                          "EFFECT_INTENT",
                          "TRANSACTION_PROFILE",
                          "TRANSACTION_TIME_POLICY",
                          "PRIOR_ASSERTION",
                          "PRIOR_CREATION_EVIDENCE"
                        ]
                      }
                    }
                  }
                },
                "else": {
                  "properties": {
                    "binding": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "ref": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        "revisionRef": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        "digest": {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        }
                      },
                      "required": [
                        "ref",
                        "digest"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "availability": {
                      "const": "COMMITTED_AT_TRANSACTION_START"
                    }
                  }
                },
                "then": {
                  "required": [
                    "snapshotVersion"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "snapshotVersion"
                    ]
                  }
                }
              }
            ]
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "priorRecord": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "binding": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "ref",
                "digest"
              ]
            },
            "rawSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "binding",
            "rawSha256"
          ]
        },
        "priorCreationEvidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "binding": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "ref",
                "digest"
              ]
            },
            "rawSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "binding",
            "rawSha256"
          ]
        },
        "priorGovernanceContext": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "boundaryKind": {
              "enum": [
                "TENANT",
                "DEPLOYMENT"
              ]
            },
            "boundaryRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "twin": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "posture": {
                      "const": "NOT_APPLICABLE"
                    }
                  },
                  "required": [
                    "posture"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "posture": {
                      "const": "APPLICABLE"
                    },
                    "twinRef": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
