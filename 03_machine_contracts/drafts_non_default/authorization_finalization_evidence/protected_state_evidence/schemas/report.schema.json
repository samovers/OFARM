              "role": {
                "enum": [
                  "EFFECT_INTENT",
                  "ASSERTION_ACT",
                  "SUBJECT",
                  "SCOPE",
                  "RELATIONSHIP_PROOF",
                  "SEMANTIC_EVENT",
                  "EVENT_INGRESS_PROOF",
                  "EVIDENCE",
                  "PAYLOAD",
                  "PRIOR_ASSERTION",
                  "PRIOR_CREATION_EVIDENCE",
                  "RULE",
                  "EVIDENCE_POLICY",
                  "AUTHORIZATION_VIEW",
                  "TRANSACTION_TIME_POLICY",
                  "TRANSACTION_PROFILE",
                  "OTHER_DOMAIN_INPUT"
