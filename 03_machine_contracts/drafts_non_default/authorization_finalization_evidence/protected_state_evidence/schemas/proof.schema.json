      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "enum": [
              "INSERT",
              "UPDATE",
              "DELETE"
            ]
          },
          "recordType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "binding": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "ref",
              "digest"
            ]
          },
          "rawSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "operation",
          "recordType",
          "key",
          "binding",
          "rawSha256"
        ]
      },
      "minItems": 1,
      "maxItems": 4096
