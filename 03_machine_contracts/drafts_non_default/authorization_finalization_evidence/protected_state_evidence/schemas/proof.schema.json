  "required": [
    "schemaVersion",
    "proofId",
    "storageOwnerRef",
    "transactionAttemptId",
    "context",
    "snapshot",
    "guardPolicy",
    "phase",
    "readGuards",
    "negativeGuards",
    "setGuards",
    "proposedDomainWrites"
  ]
