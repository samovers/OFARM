          "snapshotVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "observedVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "observation": {
            "const": "ABSENT"
