{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofarm.dev/schema/drafts/non-default/protected-state-evidence/proof/v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
