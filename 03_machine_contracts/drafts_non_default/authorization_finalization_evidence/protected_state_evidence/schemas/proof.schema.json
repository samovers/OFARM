                "enum": [
                  "JCS_JSON",
                  "RAW_BYTES"
                ]
              },
              "revisionRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "key",
              "binding",
              "rawSha256",
              "availability",
              "fixedInputVersion",
              "observedVersion"
