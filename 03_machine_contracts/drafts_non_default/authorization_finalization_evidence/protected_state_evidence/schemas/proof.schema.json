                      "ref": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "revisionRef": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "digest": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "ref",
                      "digest"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "ref": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
