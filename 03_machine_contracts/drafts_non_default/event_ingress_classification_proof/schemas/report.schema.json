{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofarm.dev/schema/drafts/non-default/event-ingress-classification-proof/report/v0.1",
  "title": "Offline classification-proof conformance report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "ofarm.eventClassificationVerificationReport.v0.1"
    },
    "status": {
      "enum": [
        "CONDITIONAL_CONFORMANCE_PASS",
        "FAIL",
        "INPUT_ERROR",
        "DEPENDENCY_UNAVAILABLE"
      ]
    },
    "contractId": {
      "const": "ofarm.event-ingress.pre-verdict-classification.v0.1"
    },
    "verificationMode": {
      "const": "OFFLINE_CANDIDATE_CONFORMANCE"
    },
    "runtimeAdmission": {
      "const": "NOT_ESTABLISHED"
    },
    "useMode": {
      "type": "string"
    },
    "proofBinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:/-]+$",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "ref",
            "digest"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "inputDigests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proof": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "envelope": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "request": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "context": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "proof",
        "envelope",
        "request",
        "context",
        "profile"
      ]
    },
    "rawInputSha256": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proof": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "envelope": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "proof",
        "envelope",
        "request",
        "context",
        "profile"
      ]
    },
    "checkedRules": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "errors": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "document": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "document",
          "pointer"
        ]
      }
    },
    "classification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "caseId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:/-]+$",
              "minLength": 1
            },
            "authoritativePrimaryFamily": {
              "enum": [
                "StructureEvent",
                "ObservationEvent",
                "OccurrenceEvent",
                "InterventionEvent",
                "MaterialEvent",
                "EvidenceEvent",
                "GovernanceEvent"
              ]
            },
            "commitClass": {
              "enum": [
                "NOTE",
                "OBSERVATION_ASSERTION",
                "HYPOTHESIS_ASSERTION",
                "STRUCTURE_ASSERTION",
                "OPERATION_CLAIM",
                "EVIDENCE_RECORD",
                "COMPLIANCE_ASSERTION",
                "GOVERNANCE_DECISION",
                "ADVISORY_OUTPUT"
              ]
            },
            "dominantSemanticConsequence": {
              "type": "string",
              "minLength": 1
            },
            "subtype": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "presence": {
                      "const": "ABSENT"
                    }
                  },
                  "required": [
                    "presence"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "presence": {
                      "const": "PRESENT"
                    },
                    "value": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9._:/-]+$",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "presence",
                    "value"
                  ]
                }
              ]
            }
          },
          "required": [
            "caseId",
            "authoritativePrimaryFamily",
            "commitClass",
            "dominantSemanticConsequence",
            "subtype"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "qualifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "contractId",
    "verificationMode",
    "runtimeAdmission",
    "useMode",
    "proofBinding",
    "inputDigests",
    "rawInputSha256",
    "checkedRules",
    "errors",
    "classification",
    "qualifications"
  ]
}
