  "descriptorMeaning": "Missing inactive structure/compliance profiles only. Proposed component data, not an admitted rule format or complete ActionAuthorizationRule. A later owning rule must pin these exact descriptor bytes. The caller does not select schemas or extractors. The existing operation/read descriptor remains unchanged.",
  "executionRules": {
    "strictJSON": "Reject duplicate names and non-JSON numbers before validation.",
    "dependencyResolution": "Verify every schema and external dependency exact-file hash, register only those bytes by the declared immutable version identity, and fail on any missing, unknown or changed reference. No network retrieval.",
    "validationOrder": [
      "STRICT_JSON",
      "SCHEMA_AND_DEPENDENCY_BINDING",
      "ROOT_SCHEMA",
      "COMPONENT_INTEGRITY_CHECKS",
      "IDENTITY_EXTRACTION",
      "JCS_RFC8785_SHA256_COMPLETE_INTENT"
    ],
    "conditions": "Each when/allOf item tests exact equality at its one literal JSON Pointer; no wildcard, normalization or fallback. A false condition disables that mapping only.",
    "optionalSource": "For required=false only an absent source skips a mapping; null or malformed present values still fail schema validation. No default value is supplied.",
    "pointers": "An active required source resolves exactly once. Validate each destination pointer and reject duplicate or ancestor/descendant destination writes among active mappings; build intermediate containers only to hold selected values. The output has no other facts.",
    "identity": "Copy the complete selected JSON value unchanged; do not resolve refs, inject trusted facts, normalize, derive authority or repair conflicts.",
    "digest": "Canonicalize the complete schema-valid input without removing any member. The digest is held by the surrounding request/evidence, not an intent self-digest.",
    "failure": "Any dependency, parse, schema, component, pointer, conflict or canonicalization failure is input-integrity failure; it never becomes ALLOW or foreign-proof PASS."
  },
