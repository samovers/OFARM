    "twin": {
      "encoding": [
        "COMPLIANCE",
        "ADVISORY"
      ],
      "presence": "Optional shape for every resource kind; PR11 §§7.5/8.3 require it where applicable but give no exhaustive kind-to-twin predicate. Actual immutable resource/context proof must establish applicability and presence/value; absence here is not an all-clear. Do not invent a kind-only rule.",
      "authorityContextSource": "/resources/0/twin",
      "otherInputs": "Each integrity input binds its own context; it never changes the authority target context."
    },
    "subjectTime": {
      "EI_STRUCTURE_ASSERTION_V0_2": "Required /subjectTime, exactly STRUCTURE_AS_OF, STRUCTURE_EFFECTIVE_FROM or STRUCTURE_EFFECTIVE_INTERVAL, independently of anchor kind.",
      "EI_COMPLIANCE_ASSERTION_V0_2": "Required /subjectTime, exactly COMPLIANCE_AS_OF, COMPLIANCE_EFFECTIVE_FROM or COMPLIANCE_EFFECTIVE_INTERVAL, independently of anchor kind."
    },
    "actionAdmission": "Both profiles remain inactive. Existing two-action admission and qualifier/resource policies are unchanged. Later admission must satisfy their own fresh-human-approval semantics; operation's NOT_REQUIRED checkpoint is not inherited."
  },
  "deferredObligations": [
    "TWIN_APPLICABILITY_AND_RESOURCE_CONTEXT_PROOF",
    "IMMUTABLE_RESOURCE_RULE_POLICY_AND_PROOF_RESOLUTION",
    "GLOBAL_PROSPECTIVE_IDENTITY_AND_RELATIONSHIP_TRUTH",
    "TRUSTED_ASSERTION_ACT_AND_OFFLINE_EVIDENCE",
    "DOMAIN_RESULT_MAPPINGS_AND_EVENT_INGRESS_COMPATIBILITY",
    "CORRECTION_PRIOR_INGRESS_AND_COMMITTED_SNAPSHOT_PROOF",
    "COMPLIANCE_ACTION_EVIDENCE_POLICY_EVALUATION",
    "FULL_THREE_ASSERTION_DOMAIN_BINDING_CLOSURE",
    "COMPLETE_SELECTED_RULES_RELEVANT_STATE_PROJECTION_AND_RELEASE_MANIFEST",
    "FRESH_HUMAN_APPROVAL_AND_SEPARATELY_APPROVED_TRANSACTION_PATH"
  ],
  "requirementFailureCodePolicy": {
    "scope": "Requirement IDs are local to this descriptor, not universal error codes. Schema validation always precedes the listed component checks; malformed prerequisite shapes fail SCHEMA first.",
    "inactiveTimeEquality": "Here BODY_TIME_EQUALITY means /assertionBody/applicability == /subjectTime and emits COMPONENT/APPLICABILITY_TIME_EQUALITY.",
    "preservedOperationTimeEquality": "In the unchanged operation descriptor, BODY_TIME_EQUALITY applies only when /assertionBody/temporalBasis/sourceKind is BODY_TIME; /assertionBody/temporalBasis/time == /subjectTime emits COMPONENT/BODY_TIME_EQUALITY."
  }
}
