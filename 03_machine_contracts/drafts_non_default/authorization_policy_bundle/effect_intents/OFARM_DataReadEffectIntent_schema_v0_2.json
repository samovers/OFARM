{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofarm.dev/schema/drafts/non-default/authorization-policy-bundle/data-read-effect-intent/v0.2",
  "title": "OFARM governed data-read effect intent v0.2 draft",
  "$comment": "DRAFT_NON_DEFAULT, INCOMPLETE, NON_EXECUTABLE. Proposed authorization-input integrity component from PR11 2b46dbed647981a55704fd69fe06b92b7240be37 and PR23 a0a06ad99516790d5b908d5de330591691dd0dcd. Validate with a local registry whose exact dependency bytes match x-ofarm-schemaDependencies. No remote/latest resolution, authority evaluation, foreign-proof validation, admission or promotion is implied.",
  "x-ofarm-schemaDependencies": [
    {
      "schemaRef": "https://ofarm.dev/schema/assertionrecord/v0.2",
      "schemaVersion": "ofarm.assertionrecord.v0.2",
      "schemaDigest": "sha256:3a7044086a2b0a226109ac00b361332503d77b07efd602b29402662515b67f1e",
      "digestBasis": "EXACT_FILE_BYTES_SHA256",
      "repositoryPath": "03_machine_contracts/drafts_non_default/assertion_record_submission/OFARM_AssertionRecord_schema_v0_2.json"
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "readForm",
    "resources",
    "effectSubject",
    "projection",
    "redactionPolicyBinding",
    "authorizationUsePurpose",
    "responseMode",
    "snapshotPolicy",
    "disclosureRequest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ofarm.datareadeffectintent.v0.2"
    },
    "readForm": {
      "enum": [
        "DIRECT",
        "QUERY"
      ]
    },
    "resources": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/readTarget"
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "$ref": "#/$defs/readTarget"
            },
            {
              "$ref": "#/$defs/querySpecification"
            },
            {
              "$ref": "#/$defs/queryPlan"
            }
          ],
          "items": false
        }
      ],
      "$comment": "Fixed tuple order: READ_TARGET, then QUERY_SPECIFICATION and QUERY_PLAN together only for QUERY. Each input has its own typed context/proofs; only index 0 carries authority. Scope targets reuse their one scope binding as target identity; record targets have a separate immutable record binding."
    },
    "effectSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectKind",
        "subjectRef",
        "existencePosture",
        "effectSubjectProofBindings"
      ],
      "properties": {
        "subjectKind": {
          "const": "DATA_DISCLOSURE"
        },
        "subjectRef": {
          "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/logicalRef"
        },
        "existencePosture": {
          "const": "PROSPECTIVE_TARGET_ALLOWED"
        },
        "effectSubjectProofBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
          }
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "fieldPointers"
      ],
      "properties": {
        "mode": {
          "const": "RESULT_ITEM_POINTERS"
        },
        "fieldPointers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/jsonPointer"
          },
          "uniqueItems": true
        }
      },
      "$comment": "Explicit pointer set relative to each logical result item, including the whole item via empty pointer. Query/plan bindings own filtering and aggregate computation; this input adds no query language. A direct read has no implicit query input."
    },
    "redactionPolicyBinding": {
      "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding",
      "$comment": "Exact revision/digest binding is input content, not proof the policy is eligible. Foreign policy applicability and non-weakening remain mandatory outside schema validity."
    },
    "responseMode": {
      "const": "BUFFERED"
    },
    "snapshotPolicy": {
      "const": "ONE_GOVERNED_READ_SNAPSHOT",
      "$comment": "PR11 \u00a718.5: one governed snapshot covers authorization, retrieval, redaction, qualification, coverage and payload construction. This names the requested semantic invariant, not a chosen database isolation mechanism, actual trusted snapshot, or successful proof."
    },
    "disclosureRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregates",
        "count",
        "metadata",
        "lineage"
      ],
      "properties": {
        "aggregates": {
          "type": "boolean"
        },
        "count": {
          "type": "boolean"
        },
        "metadata": {
          "type": "boolean"
        },
        "lineage": {
          "type": "boolean"
        }
      },
      "$comment": "Requested inclusion categories only. False prohibits that category in the requested output; true requests it without creating permission or overriding projection, redaction, CP2, coverage or inference checks. Concrete query aggregation is bound by the immutable query/plan, not inferred from these booleans."
    },
    "authorizationUsePurpose": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}(?![\\s\\S])"
    },
    "scopeProofBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
      }
    },
    "dataSovereigntyBoundaryBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
      }
    }
  },
  "$defs": {
    "scopeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceRole",
        "resourcePosture",
        "targetType",
        "scope",
        "tenantRef",
        "authorizationResourceProofBindings"
      ],
      "properties": {
        "resourceRole": {
          "const": "READ_TARGET"
        },
        "resourcePosture": {
          "const": "AUTHORITY_TARGET"
        },
        "targetType": {
          "const": "SCOPE"
        },
        "scope": {
          "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/anchorScope"
        },
        "tenantRef": {
          "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/logicalRef"
        },
        "twin": {
          "enum": [
            "COMPLIANCE",
            "ADVISORY"
          ],
          "$comment": "Encoding only. Governed immutable resource/context proof determines applicability. Omission is not a claim of NOT_APPLICABLE."
        },
        "authorizationResourceProofBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
          }
        }
      }
    },
    "recordTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceRole",
        "resourcePosture",
        "targetType",
        "resourceKind",
        "resourceBinding",
        "scope",
        "tenantRef",
        "authorizationResourceProofBindings"
      ],
      "properties": {
        "resourceRole": {
          "const": "READ_TARGET"
        },
        "resourcePosture": {
          "const": "AUTHORITY_TARGET"
        },
        "targetType": {
          "const": "RECORD"
        },
        "resourceKind": {
          "enum": [
            "OBSERVATION",
            "EVIDENCE_RECORD",
            "STRUCTURE_ASSERTION",
            "OPERATION_ASSERTION",
            "COMPLIANCE_ASSERTION",
            "INTERVENTION_PLAN",
            "EXECUTION_REPORT",
            "REVIEW_REQUEST",
            "REVIEW_DECISION",
            "PACK_INSTALLATION",
            "PACK_ACTIVATION_SET",
            "DOCUMENT_ASSEMBLY",
            "DOSSIER_ASSEMBLY",
            "SUBMISSION_ASSEMBLY",
            "EVIDENCE_BUNDLE",
            "CURRENT_STATE_MATERIALIZATION",
            "SHARING_GRANT",
            "REVOCATION_DECISION",
            "PASSPORT_VIEW",
            "AUTHORIZATION_TRACE"
          ]
        },
        "resourceBinding": {
          "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
        },
        "scope": {
          "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/anchorScope"
        },
        "tenantRef": {
          "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/logicalRef"
        },
        "twin": {
          "enum": [
            "COMPLIANCE",
            "ADVISORY"
          ],
          "$comment": "Encoding only. Governed immutable resource/context proof determines applicability. Omission is not a claim of NOT_APPLICABLE."
        },
        "authorizationResourceProofBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
          }
        }
      }
    },
    "querySpecification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceRole",
        "resourcePosture",
        "targetType",
        "resourceKind",
        "resourceBinding",
        "scope",
        "tenantRef",
        "authorizationResourceProofBindings"
      ],
      "properties": {
        "resourceRole": {
          "const": "QUERY_SPECIFICATION"
        },
        "resourcePosture": {
          "const": "INTEGRITY_INPUT"
        },
        "targetType": {
          "const": "RECORD"
        },
        "resourceKind": {
          "const": "QUERY_SPECIFICATION"
        },
        "resourceBinding": {
          "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
        },
        "scope": {
          "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/anchorScope"
        },
        "tenantRef": {
          "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/logicalRef"
        },
        "twin": {
          "enum": [
            "COMPLIANCE",
            "ADVISORY"
          ],
          "$comment": "Encoding only. Governed immutable resource/context proof determines applicability. Omission is not a claim of NOT_APPLICABLE."
        },
        "authorizationResourceProofBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
          }
        }
      }
    },
    "queryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceRole",
        "resourcePosture",
        "targetType",
        "resourceKind",
        "resourceBinding",
        "scope",
        "tenantRef",
        "authorizationResourceProofBindings"
      ],
      "properties": {
        "resourceRole": {
          "const": "QUERY_PLAN"
        },
        "resourcePosture": {
          "const": "INTEGRITY_INPUT"
        },
        "targetType": {
          "const": "RECORD"
        },
        "resourceKind": {
          "const": "QUERY_PLAN"
        },
        "resourceBinding": {
          "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
        },
        "scope": {
          "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/anchorScope"
        },
        "tenantRef": {
          "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/logicalRef"
        },
        "twin": {
          "enum": [
            "COMPLIANCE",
            "ADVISORY"
          ],
          "$comment": "Encoding only. Governed immutable resource/context proof determines applicability. Omission is not a claim of NOT_APPLICABLE."
        },
        "authorizationResourceProofBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
          }
        }
      }
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*(?![\\s\\S])",
      "$comment": "RFC6901 pointer in JSON string representation, not a URI fragment or wildcard expression. Empty selects the entire result item. Semantic path existence is checked against the resolved result shape, outside this component."
    },
    "readTarget": {
      "oneOf": [
        {
          "$ref": "#/$defs/scopeTarget"
        },
        {
          "$ref": "#/$defs/recordTarget"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "readForm"
        ],
        "properties": {
          "readForm": {
            "const": "DIRECT"
          }
        }
      },
      "then": {
        "properties": {
          "resources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
              {
                "$ref": "#/$defs/readTarget"
              }
            ],
            "items": false
          }
        }
      },
      "else": {
        "properties": {
          "resources": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              {
                "$ref": "#/$defs/readTarget"
              },
              {
                "$ref": "#/$defs/querySpecification"
              },
              {
                "$ref": "#/$defs/queryPlan"
              }
            ],
            "items": false
          }
        }
      }
    }
  ]
}
