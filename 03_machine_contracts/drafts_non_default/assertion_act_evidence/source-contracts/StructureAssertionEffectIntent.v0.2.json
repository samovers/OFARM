{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofarm.dev/schema/drafts/non-default/authorization-policy-bundle/structure-assertion-effect-intent/v0.2",
  "title": "OFARM structure assertion effect intent v0.2 draft",
  "$comment": "DRAFT_NON_DEFAULT, INCOMPLETE, NON_EXECUTABLE. Inactive authorization-input integrity component from PR11 d1178fe07d57accedde5748672602db38346b3e6 and PR23 6c5c6eb754baecfa38b7e364fc3d0318ae1ad89f. Reuse exact PR42 targetScope and PR41 body/time bytes through x-ofarm-schemaDependencies. Validate only with their hash-verified local registry; no remote/latest resolution. Shape and exact extraction do not prove foreign facts, domain validity, approval or action admission. Fresh human approval remains a separate owner obligation; operation's NOT_REQUIRED mode is not inherited.",
  "x-ofarm-schemaDependencies": [
    {
      "schemaRef": "https://ofarm.dev/schema/drafts/non-default/authorization-policy-bundle/operation-assertion-effect-intent/v0.2",
      "schemaVersion": "ofarm.operationassertioneffectintent.v0.2",
      "schemaDigest": "sha256:66825f09c714a2f4ad7dea2ee24d7f20bbd3a2c0f3241d5b14a6aff2227cf5f6",
      "digestBasis": "EXACT_FILE_BYTES_SHA256",
      "repositoryPath": "03_machine_contracts/drafts_non_default/authorization_policy_bundle/effect_intents/OFARM_OperationAssertionEffectIntent_schema_v0_2.json"
    },
    {
      "schemaRef": "https://ofarm.dev/schema/assertionrecord/v0.2",
      "schemaVersion": "ofarm.assertionrecord.v0.2",
      "schemaDigest": "sha256:3a7044086a2b0a226109ac00b361332503d77b07efd602b29402662515b67f1e",
      "digestBasis": "EXACT_FILE_BYTES_SHA256",
      "repositoryPath": "03_machine_contracts/drafts_non_default/assertion_record_submission/OFARM_AssertionRecord_schema_v0_2.json"
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resources",
    "effectSubject",
    "subject",
    "assertedAt",
    "assertionActPosture",
    "subjectTime",
    "assertionBody",
    "evidenceBindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ofarm.structureassertioneffectintent.v0.2"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "$ref": "https://ofarm.dev/schema/drafts/non-default/authorization-policy-bundle/operation-assertion-effect-intent/v0.2#/$defs/targetScope"
        }
      ],
      "items": false
    },
    "effectSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectKind",
        "subjectRef",
        "existencePosture",
        "effectSubjectProofBindings"
      ],
      "properties": {
        "subjectKind": {
          "const": "STRUCTURE_ASSERTION"
        },
        "subjectRef": {
          "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/logicalRef"
        },
        "existencePosture": {
          "const": "PROSPECTIVE_TARGET_ALLOWED"
        },
        "effectSubjectProofBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
          }
        }
      }
    },
    "subject": {
      "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/subject"
    },
    "assertedAt": {
      "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/canonicalTimestamp",
      "$comment": "Trusted online injection or resolved immutable offline evidence, before validation/digest. JSON Schema validates shape, not origin."
    },
    "assertionActPosture": {
      "enum": [
        "TRUSTED_ONLINE_SUBMISSION",
        "VERIFIED_OFFLINE_SUBMISSION"
      ]
    },
    "assertionActEvidenceBinding": {
      "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
    },
    "subjectTime": {
      "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/structureTime"
    },
    "assertionBody": {
      "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/structureAssertionBody",
      "$comment": "The complete applicability object must equal subjectTime exactly in the component checker. Claim text is preserved, not interpreted or compiled."
    },
    "evidenceBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
      }
    },
    "subjectScopeProofBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
      }
    },
    "supersedesAssertionRecordBinding": {
      "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
    },
    "associatedSemanticEventBinding": {
      "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding",
      "$comment": "Exact PR23 §7.3 binding shape only; foreign Event Ingress and domain compatibility are separately required. Never derive event family here."
    },
    "authorizationUsePurpose": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,127}(?![\\s\\S])"
    },
    "scopeProofBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
      }
    },
    "dataSovereigntyBoundaryBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://ofarm.dev/schema/assertionrecord/v0.2#/$defs/immutableBinding"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "assertionActPosture"
        ],
        "properties": {
          "assertionActPosture": {
            "const": "VERIFIED_OFFLINE_SUBMISSION"
          }
        }
      },
      "then": {
        "required": [
          "assertionActEvidenceBinding"
        ]
      },
      "else": {
        "properties": {
          "assertionActEvidenceBinding": false
        }
      }
    },
    {
      "if": {
        "required": [
          "assertionBody"
        ],
        "properties": {
          "assertionBody": {
            "required": [
              "assertionPosture"
            ],
            "properties": {
              "assertionPosture": {
                "const": "CORRECTION"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "supersedesAssertionRecordBinding"
        ]
      },
      "else": {
        "properties": {
          "supersedesAssertionRecordBinding": false
        }
      }
    },
    {
      "if": {
        "required": [
          "subject"
        ],
        "properties": {
          "subject": {
            "required": [
              "subjectPosture"
            ],
            "properties": {
              "subjectPosture": {
                "const": "PROSPECTIVE_SUBJECT"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "subjectScopeProofBindings"
        ]
      }
    }
  ]
}
