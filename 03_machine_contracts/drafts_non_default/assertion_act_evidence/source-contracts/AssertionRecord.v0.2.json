{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofarm.dev/schema/assertionrecord/v0.2",
  "title": "OFARM AssertionRecord v0.2 draft submission carrier",
  "$comment": "DRAFT_NON_DEFAULT. Proposed machine materialization from PR #23 a0a06ad99516790d5b908d5de330591691dd0dcd, source sha256:0d654293a5e4a9f0b3b1efa5a9025f34d0a335c3f2f2fb2299c9e5538e6ff999. Construction changes neither semantic acceptance nor current/default v0.1. Root validates assertionRecord; the three bodies are independently addressable by their agreed $defs pointers. This is not the protected-effect contract or a shared evidence envelope.",
  "$ref": "#/$defs/assertionRecord",
  "$defs": {
    "logicalRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$(?![\\s\\S])"
    },
    "immutableRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/:-]+$(?![\\s\\S])",
      "$comment": "Spelling is not proof of immutable resolution. Mutable aliases and unresolved selectors must fail at the owning resolver."
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "canonicalTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{0,8}[1-9])?Z$(?![\\s\\S])",
      "$comment": "PR #23 section 6.3. A format-checking validator must additionally reject invalid calendar dates. No normalization or rounding is authorized."
    },
    "immutableBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/immutableRef"
        },
        "revisionRef": {
          "$ref": "#/$defs/immutableRef"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      },
      "oneOf": [
        {
          "required": [
            "revisionRef"
          ],
          "not": {
            "required": [
              "digest"
            ]
          }
        },
        {
          "required": [
            "digest"
          ],
          "not": {
            "required": [
              "revisionRef"
            ]
          }
        }
      ],
      "$comment": "The containing field fixes the referenced kind. Exactly one immutable selector; resolution and content integrity are not established by this schema."
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectPosture",
        "subjectType",
        "subjectRef"
      ],
      "properties": {
        "subjectPosture": {
          "enum": [
            "EXISTING_SUBJECT",
            "PROSPECTIVE_SUBJECT"
          ]
        },
        "subjectType": {
          "enum": [
            "FARM",
            "SITE",
            "FIELD",
            "ZONE",
            "CROP_CYCLE",
            "LOT",
            "FACILITY",
            "OPERATION",
            "INPUT"
          ]
        },
        "subjectRef": {
          "$ref": "#/$defs/logicalRef"
        },
        "revisionRef": {
          "$ref": "#/$defs/immutableRef"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "subjectPosture": {
                "const": "EXISTING_SUBJECT"
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "revisionRef"
                ],
                "not": {
                  "required": [
                    "digest"
                  ]
                }
              },
              {
                "required": [
                  "digest"
                ],
                "not": {
                  "required": [
                    "revisionRef"
                  ]
                }
              }
            ]
          },
          "else": {
            "properties": {
              "revisionRef": false,
              "digest": false
            }
          }
        }
      ]
    },
    "anchorScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeType",
        "scopeRef"
      ],
      "properties": {
        "scopeType": {
          "enum": [
            "FARM",
            "SITE",
            "FIELD",
            "ZONE",
            "CROP_CYCLE",
            "LOT",
            "FACILITY",
            "OPERATION",
            "DEPLOYMENT",
            "TENANT"
          ]
        },
        "scopeRef": {
          "$ref": "#/$defs/logicalRef"
        },
        "revisionRef": {
          "$ref": "#/$defs/immutableRef"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      },
      "oneOf": [
        {
          "required": [
            "revisionRef"
          ],
          "not": {
            "required": [
              "digest"
            ]
          }
        },
        {
          "required": [
            "digest"
          ],
          "not": {
            "required": [
              "revisionRef"
            ]
          }
        }
      ]
    },
    "contextBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextRole",
        "binding",
        "relationshipProofBindings"
      ],
      "properties": {
        "contextRole": {
          "enum": [
            "FARM",
            "SITE",
            "FIELD",
            "ZONE",
            "CROP_CYCLE",
            "LOT",
            "FACILITY",
            "OPERATION",
            "INPUT"
          ]
        },
        "binding": {
          "$ref": "#/$defs/immutableBinding"
        },
        "relationshipProofBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/immutableBinding"
          }
        }
      },
      "$comment": "The contextRole fixes binding kind. Immutable relationship-proof bindings retain claim context without creating another authority anchor. Proof resolution and completeness remain external."
    },
    "STRUCTURE_AS_OF": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "at"
      ],
      "properties": {
        "profile": {
          "const": "STRUCTURE_AS_OF"
        },
        "at": {
          "$ref": "#/$defs/canonicalTimestamp"
        }
      }
    },
    "STRUCTURE_EFFECTIVE_FROM": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "start"
      ],
      "properties": {
        "profile": {
          "const": "STRUCTURE_EFFECTIVE_FROM"
        },
        "start": {
          "$ref": "#/$defs/canonicalTimestamp"
        }
      }
    },
    "STRUCTURE_EFFECTIVE_INTERVAL": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "start",
        "end"
      ],
      "properties": {
        "profile": {
          "const": "STRUCTURE_EFFECTIVE_INTERVAL"
        },
        "start": {
          "$ref": "#/$defs/canonicalTimestamp"
        },
        "end": {
          "$ref": "#/$defs/canonicalTimestamp"
        }
      },
      "$comment": "Half-open [start,end). The component checker must compare exact UTC instants and require start < end; JSON Schema cannot compare sibling values."
    },
    "INTENDED_WINDOW": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "start",
        "end"
      ],
      "properties": {
        "profile": {
          "const": "INTENDED_WINDOW"
        },
        "start": {
          "$ref": "#/$defs/canonicalTimestamp"
        },
        "end": {
          "$ref": "#/$defs/canonicalTimestamp"
        }
      },
      "$comment": "Half-open [start,end). The component checker must compare exact UTC instants and require start < end; JSON Schema cannot compare sibling values."
    },
    "PERFORMED_INSTANT": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "at"
      ],
      "properties": {
        "profile": {
          "const": "PERFORMED_INSTANT"
        },
        "at": {
          "$ref": "#/$defs/canonicalTimestamp"
        }
      }
    },
    "PERFORMED_INTERVAL": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "start",
        "end"
      ],
      "properties": {
        "profile": {
          "const": "PERFORMED_INTERVAL"
        },
        "start": {
          "$ref": "#/$defs/canonicalTimestamp"
        },
        "end": {
          "$ref": "#/$defs/canonicalTimestamp"
        }
      },
      "$comment": "Half-open [start,end). The component checker must compare exact UTC instants and require start < end; JSON Schema cannot compare sibling values."
    },
    "COMPLIANCE_AS_OF": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "at"
      ],
      "properties": {
        "profile": {
          "const": "COMPLIANCE_AS_OF"
        },
        "at": {
          "$ref": "#/$defs/canonicalTimestamp"
        }
      }
    },
    "COMPLIANCE_EFFECTIVE_FROM": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "start"
      ],
      "properties": {
        "profile": {
          "const": "COMPLIANCE_EFFECTIVE_FROM"
        },
        "start": {
          "$ref": "#/$defs/canonicalTimestamp"
        }
      }
    },
    "COMPLIANCE_EFFECTIVE_INTERVAL": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "start",
        "end"
      ],
      "properties": {
        "profile": {
          "const": "COMPLIANCE_EFFECTIVE_INTERVAL"
        },
        "start": {
          "$ref": "#/$defs/canonicalTimestamp"
        },
        "end": {
          "$ref": "#/$defs/canonicalTimestamp"
        }
      },
      "$comment": "Half-open [start,end). The component checker must compare exact UTC instants and require start < end; JSON Schema cannot compare sibling values."
    },
    "structureTime": {
      "oneOf": [
        {
          "$ref": "#/$defs/STRUCTURE_AS_OF"
        },
        {
          "$ref": "#/$defs/STRUCTURE_EFFECTIVE_FROM"
        },
        {
          "$ref": "#/$defs/STRUCTURE_EFFECTIVE_INTERVAL"
        }
      ]
    },
    "operationTime": {
      "oneOf": [
        {
          "$ref": "#/$defs/INTENDED_WINDOW"
        },
        {
          "$ref": "#/$defs/PERFORMED_INSTANT"
        },
        {
          "$ref": "#/$defs/PERFORMED_INTERVAL"
        }
      ]
    },
    "complianceTime": {
      "oneOf": [
        {
          "$ref": "#/$defs/COMPLIANCE_AS_OF"
        },
        {
          "$ref": "#/$defs/COMPLIANCE_EFFECTIVE_FROM"
        },
        {
          "$ref": "#/$defs/COMPLIANCE_EFFECTIVE_INTERVAL"
        }
      ]
    },
    "subjectTime": {
      "oneOf": [
        {
          "$ref": "#/$defs/STRUCTURE_AS_OF"
        },
        {
          "$ref": "#/$defs/STRUCTURE_EFFECTIVE_FROM"
        },
        {
          "$ref": "#/$defs/STRUCTURE_EFFECTIVE_INTERVAL"
        },
        {
          "$ref": "#/$defs/INTENDED_WINDOW"
        },
        {
          "$ref": "#/$defs/PERFORMED_INSTANT"
        },
        {
          "$ref": "#/$defs/PERFORMED_INTERVAL"
        },
        {
          "$ref": "#/$defs/COMPLIANCE_AS_OF"
        },
        {
          "$ref": "#/$defs/COMPLIANCE_EFFECTIVE_FROM"
        },
        {
          "$ref": "#/$defs/COMPLIANCE_EFFECTIVE_INTERVAL"
        }
      ]
    },
    "interventionIntentPayloadBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "schemaRef",
        "schemaVersion",
        "schemaDigest"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/immutableRef"
        },
        "revisionRef": {
          "$ref": "#/$defs/immutableRef"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "schemaRef": {
          "const": "https://ofarm.dev/schema/interventionintentpayload/v0.1"
        },
        "schemaVersion": {
          "const": "ofarm.interventionintentpayload.v0.1"
        },
        "schemaDigest": {
          "const": "sha256:72e4603d3cc98fcd99439f8a06c80724e14d4961031ff3b0a1774f3407725ec0"
        }
      },
      "oneOf": [
        {
          "required": [
            "revisionRef"
          ],
          "not": {
            "required": [
              "digest"
            ]
          }
        },
        {
          "required": [
            "digest"
          ],
          "not": {
            "required": [
              "revisionRef"
            ]
          }
        }
      ],
      "$comment": "Binds actual schema bytes at 03_machine_contracts/schemas/agronomic/OFARM_InterventionIntentPayload_schema_v0_1.json, canonical base 4a3d88ea6eff4b3f8a2c521dc621595cbfd1657b. The referenced record itself still needs immutable resolution and validation; this is not embedded payload data."
    },
    "executionRecordPayloadBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "schemaRef",
        "schemaVersion",
        "schemaDigest"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/immutableRef"
        },
        "revisionRef": {
          "$ref": "#/$defs/immutableRef"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "schemaRef": {
          "const": "https://ofarm.dev/schema/executionrecordpayload/v0.1"
        },
        "schemaVersion": {
          "const": "ofarm.executionrecordpayload.v0.1"
        },
        "schemaDigest": {
          "const": "sha256:ca62f01d056794ee588d55c3f5df652fc039124b76af5631d417714bc7059ff0"
        }
      },
      "oneOf": [
        {
          "required": [
            "revisionRef"
          ],
          "not": {
            "required": [
              "digest"
            ]
          }
        },
        {
          "required": [
            "digest"
          ],
          "not": {
            "required": [
              "revisionRef"
            ]
          }
        }
      ],
      "$comment": "Binds actual schema bytes at 03_machine_contracts/schemas/agronomic/OFARM_ExecutionRecordPayload_schema_v0_1.json, canonical base 4a3d88ea6eff4b3f8a2c521dc621595cbfd1657b. The referenced record itself still needs immutable resolution and validation; this is not embedded payload data."
    },
    "measurementEvidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "schemaRef",
        "schemaVersion",
        "schemaDigest"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/immutableRef"
        },
        "revisionRef": {
          "$ref": "#/$defs/immutableRef"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "schemaRef": {
          "const": "https://ofarm.dev/schema/measurementevidence/v0.1"
        },
        "schemaVersion": {
          "const": "ofarm.measurementevidence.v0.1"
        },
        "schemaDigest": {
          "const": "sha256:90c4cf2d1387633172e772c970d0c76889ceec0fca4682a5053914375bdc9280"
        }
      },
      "oneOf": [
        {
          "required": [
            "revisionRef"
          ],
          "not": {
            "required": [
              "digest"
            ]
          }
        },
        {
          "required": [
            "digest"
          ],
          "not": {
            "required": [
              "revisionRef"
            ]
          }
        }
      ],
      "$comment": "Binds actual schema bytes at 03_machine_contracts/schemas/evidence/OFARM_MeasurementEvidence_schema_v0_1.json, canonical base 4a3d88ea6eff4b3f8a2c521dc621595cbfd1657b. The referenced record itself still needs immutable resolution and validation; this is not embedded payload data."
    },
    "intendedBodyTimeBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "time"
      ],
      "properties": {
        "sourceKind": {
          "const": "BODY_TIME"
        },
        "time": {
          "$ref": "#/$defs/INTENDED_WINDOW"
        }
      }
    },
    "performedBodyTimeBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "time"
      ],
      "properties": {
        "sourceKind": {
          "const": "BODY_TIME"
        },
        "time": {
          "$ref": "#/$defs/PERFORMED_INTERVAL"
        }
      }
    },
    "intentPayloadTimeBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "payloadBinding",
        "startPointer",
        "endPointer"
      ],
      "properties": {
        "sourceKind": {
          "const": "INTERVENTION_INTENT_PAYLOAD"
        },
        "payloadBinding": {
          "$ref": "#/$defs/interventionIntentPayloadBinding"
        },
        "startPointer": {
          "const": "/intendedTimeWindow/start"
        },
        "endPointer": {
          "const": "/intendedTimeWindow/end"
        }
      }
    },
    "executionPayloadTimeBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "payloadBinding",
        "startPointer",
        "endPointer"
      ],
      "properties": {
        "sourceKind": {
          "const": "EXECUTION_RECORD_PAYLOAD"
        },
        "payloadBinding": {
          "$ref": "#/$defs/executionRecordPayloadBinding"
        },
        "startPointer": {
          "const": "/effectiveTimeInterval/start"
        },
        "endPointer": {
          "const": "/effectiveTimeInterval/end"
        }
      }
    },
    "performedInstantEvidenceBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "evidenceBinding",
        "atPointer"
      ],
      "properties": {
        "sourceKind": {
          "const": "MEASUREMENT_EVIDENCE"
        },
        "evidenceBinding": {
          "$ref": "#/$defs/measurementEvidenceBinding"
        },
        "atPointer": {
          "const": "/phenomenonTime/instant"
        }
      },
      "$comment": "Resolved MeasurementEvidence must have phenomenonTime.timeType INSTANT, an actual phenomenonTime.instant, and compatible claimed-performance context. resultTime/capture/record time are never a temporal source. This schema does not resolve or attest that foreign evidence."
    },
    "intendedTimeBasis": {
      "oneOf": [
        {
          "$ref": "#/$defs/intendedBodyTimeBasis"
        },
        {
          "$ref": "#/$defs/intentPayloadTimeBasis"
        }
      ]
    },
    "performedIntervalBasis": {
      "oneOf": [
        {
          "$ref": "#/$defs/performedBodyTimeBasis"
        },
        {
          "$ref": "#/$defs/executionPayloadTimeBasis"
        }
      ]
    },
    "operationTemporalBasis": {
      "oneOf": [
        {
          "$ref": "#/$defs/intendedBodyTimeBasis"
        },
        {
          "$ref": "#/$defs/performedBodyTimeBasis"
        },
        {
          "$ref": "#/$defs/intentPayloadTimeBasis"
        },
        {
          "$ref": "#/$defs/executionPayloadTimeBasis"
        },
        {
          "$ref": "#/$defs/performedInstantEvidenceBasis"
        }
      ]
    },
    "structureAssertionBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertionPosture",
        "claimText",
        "applicability"
      ],
      "properties": {
        "assertionPosture": {
          "enum": [
            "INITIAL",
            "CORRECTION"
          ]
        },
        "claimText": {
          "type": "string",
          "minLength": 1,
          "$comment": "Exact claimed statement inside the action-typed body; not executable policy, interpreted rule language, or result-local notes."
        },
        "contextBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/contextBinding"
          }
        },
        "applicability": {
          "$ref": "#/$defs/structureTime"
        }
      },
      "$comment": "Closed structure claim body. applicability is the exact source of result subjectTime; full object equality is required by the component checker. Context binds existing named domain kinds without granting authority. No body-kind discriminator is added."
    },
    "complianceAssertionBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertionPosture",
        "claimText",
        "applicability"
      ],
      "properties": {
        "assertionPosture": {
          "enum": [
            "INITIAL",
            "CORRECTION"
          ]
        },
        "claimText": {
          "type": "string",
          "minLength": 1,
          "$comment": "Exact claimed statement inside the action-typed body; not executable policy, interpreted rule language, or result-local notes."
        },
        "contextBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/contextBinding"
          }
        },
        "applicability": {
          "$ref": "#/$defs/complianceTime"
        }
      },
      "$comment": "Closed compliance claim body. applicability is the exact source of result subjectTime; full object equality is required by the component checker. Context binds existing named domain kinds without granting authority. No body-kind discriminator is added."
    },
    "operationClaimBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertionPosture",
        "claimText",
        "temporalBasis",
        "allegesSoftwareAgentPerformance"
      ],
      "properties": {
        "assertionPosture": {
          "enum": [
            "INITIAL",
            "CORRECTION"
          ]
        },
        "claimText": {
          "type": "string",
          "minLength": 1,
          "$comment": "Exact claimed statement inside the action-typed body; not executable policy, interpreted rule language, or result-local notes."
        },
        "contextBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/contextBinding"
          }
        },
        "temporalBasis": {
          "$ref": "#/$defs/operationTemporalBasis"
        },
        "allegesSoftwareAgentPerformance": {
          "type": "boolean"
        },
        "interventionIntentPayloadBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/interventionIntentPayloadBinding"
          }
        },
        "executionRecordPayloadBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/executionRecordPayloadBinding"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "temporalBasis": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/intendedBodyTimeBasis"
                  },
                  {
                    "$ref": "#/$defs/intentPayloadTimeBasis"
                  }
                ]
              }
            }
          },
          "then": {
            "properties": {
              "allegesSoftwareAgentPerformance": {
                "const": false
              }
            }
          }
        }
      ],
      "$comment": "Exact operation claim. Payload bindings are immutable record references, not loose legacy arrays or new payload copies. Temporal selection does not create accepted execution. claimPosture is retained only in the owning result operationClaimContext; temporal branches constrain its consistency."
    },
    "operationClaimContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimPosture",
        "performedByPartyRef"
      ],
      "properties": {
        "claimPosture": {
          "enum": [
            "INTENDED",
            "PERFORMED"
          ]
        },
        "performedByPartyRef": {
          "$ref": "#/$defs/logicalRef"
        },
        "softwareAgentActorshipBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/immutableBinding"
          }
        },
        "performerAuthorityEvidenceBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/immutableBinding"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claimPosture": {
                "const": "INTENDED"
              }
            }
          },
          "then": {
            "properties": {
              "softwareAgentActorshipBindings": false,
              "performerAuthorityEvidenceBindings": false
            }
          }
        }
      ],
      "$comment": "performedByPartyRef names the intended or alleged performer; it is never derived from assertedByPartyRef. Reporter and performer may coincide but remain independent facts. Performer authority is NOT_EVALUATED_BY_AUTHORIZATION; optional evidence does not assert an authorization result."
    },
    "complianceBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleRevisionBindings",
        "evidencePolicyRevisionBindings"
      ],
      "properties": {
        "ruleRevisionBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/immutableBinding"
          }
        },
        "evidencePolicyRevisionBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/immutableBinding"
          }
        }
      }
    },
    "assertionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "assertionRecordId",
        "assertionType",
        "subject",
        "anchorScopes",
        "assertedByPartyRef",
        "assertedAt",
        "assertionActPosture",
        "subjectTime",
        "assertionBody",
        "evidenceBindings",
        "claimState"
      ],
      "properties": {
        "schemaVersion": {
          "const": "ofarm.assertionrecord.v0.2"
        },
        "assertionRecordId": {
          "$ref": "#/$defs/logicalRef"
        },
        "assertionType": {
          "enum": [
            "STRUCTURE_ASSERTION",
            "OPERATION_CLAIM_ASSERTION",
            "COMPLIANCE_ASSERTION"
          ]
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "anchorScopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/anchorScope"
          }
        },
        "assertedByPartyRef": {
          "$ref": "#/$defs/logicalRef"
        },
        "assertedAt": {
          "$ref": "#/$defs/canonicalTimestamp"
        },
        "assertionActPosture": {
          "enum": [
            "TRUSTED_ONLINE_SUBMISSION",
            "VERIFIED_OFFLINE_SUBMISSION"
          ]
        },
        "assertionActEvidenceBinding": {
          "$ref": "#/$defs/immutableBinding"
        },
        "subjectTime": {
          "$ref": "#/$defs/subjectTime"
        },
        "assertionBody": {
          "oneOf": [
            {
              "$ref": "#/$defs/structureAssertionBody"
            },
            {
              "$ref": "#/$defs/operationClaimBody"
            },
            {
              "$ref": "#/$defs/complianceAssertionBody"
            }
          ]
        },
        "evidenceBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/immutableBinding"
          }
        },
        "subjectScopeProofBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/immutableBinding"
          }
        },
        "claimState": {
          "const": "PENDING_REVIEW"
        },
        "supersedesAssertionRecordBinding": {
          "$ref": "#/$defs/immutableBinding"
        },
        "operationClaimContext": {
          "$ref": "#/$defs/operationClaimContext"
        },
        "complianceBasis": {
          "$ref": "#/$defs/complianceBasis"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assertionActPosture": {
                "const": "VERIFIED_OFFLINE_SUBMISSION"
              }
            }
          },
          "then": {
            "required": [
              "assertionActEvidenceBinding"
            ]
          },
          "else": {
            "properties": {
              "assertionActEvidenceBinding": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "assertionBody": {
                "properties": {
                  "assertionPosture": {
                    "const": "CORRECTION"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "supersedesAssertionRecordBinding"
            ]
          },
          "else": {
            "properties": {
              "supersedesAssertionRecordBinding": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "subject": {
                "properties": {
                  "subjectPosture": {
                    "const": "PROSPECTIVE_SUBJECT"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "subjectScopeProofBindings"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "assertionType": {
                "const": "STRUCTURE_ASSERTION"
              }
            }
          },
          "then": {
            "properties": {
              "assertionBody": {
                "$ref": "#/$defs/structureAssertionBody"
              },
              "subjectTime": {
                "$ref": "#/$defs/structureTime"
              },
              "operationClaimContext": false,
              "complianceBasis": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "assertionType": {
                "const": "COMPLIANCE_ASSERTION"
              }
            }
          },
          "then": {
            "required": [
              "complianceBasis"
            ],
            "properties": {
              "assertionBody": {
                "$ref": "#/$defs/complianceAssertionBody"
              },
              "subjectTime": {
                "$ref": "#/$defs/complianceTime"
              },
              "operationClaimContext": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "assertionType": {
                "const": "OPERATION_CLAIM_ASSERTION"
              }
            }
          },
          "then": {
            "required": [
              "operationClaimContext"
            ],
            "properties": {
              "assertionBody": {
                "$ref": "#/$defs/operationClaimBody"
              },
              "subjectTime": {
                "$ref": "#/$defs/operationTime"
              },
              "complianceBasis": false
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "operationClaimContext": {
                      "properties": {
                        "claimPosture": {
                          "const": "INTENDED"
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "subjectTime": {
                      "$ref": "#/$defs/INTENDED_WINDOW"
                    },
                    "assertionBody": {
                      "properties": {
                        "temporalBasis": {
                          "$ref": "#/$defs/intendedTimeBasis"
                        },
                        "allegesSoftwareAgentPerformance": {
                          "const": false
                        }
                      }
                    }
                  }
                },
                "else": {
                  "properties": {
                    "subjectTime": {
                      "oneOf": [
                        {
                          "$ref": "#/$defs/PERFORMED_INSTANT"
                        },
                        {
                          "$ref": "#/$defs/PERFORMED_INTERVAL"
                        }
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "assertionBody": {
                      "properties": {
                        "allegesSoftwareAgentPerformance": {
                          "const": true
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "operationClaimContext": {
                      "required": [
                        "softwareAgentActorshipBindings"
                      ],
                      "properties": {
                        "claimPosture": {
                          "const": "PERFORMED"
                        }
                      }
                    }
                  }
                },
                "else": {
                  "properties": {
                    "operationClaimContext": {
                      "properties": {
                        "softwareAgentActorshipBindings": false
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "subjectTime": {
                      "properties": {
                        "profile": {
                          "const": "PERFORMED_INSTANT"
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "assertionBody": {
                      "properties": {
                        "temporalBasis": {
                          "$ref": "#/$defs/performedInstantEvidenceBasis"
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "subjectTime": {
                      "properties": {
                        "profile": {
                          "const": "PERFORMED_INTERVAL"
                        }
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "assertionBody": {
                      "properties": {
                        "temporalBasis": {
                          "$ref": "#/$defs/performedIntervalBasis"
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "subjectTime": {
                "properties": {
                  "profile": {
                    "const": "STRUCTURE_AS_OF"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "assertionBody": {
                "properties": {
                  "applicability": {
                    "properties": {
                      "profile": {
                        "const": "STRUCTURE_AS_OF"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "subjectTime": {
                "properties": {
                  "profile": {
                    "const": "STRUCTURE_EFFECTIVE_FROM"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "assertionBody": {
                "properties": {
                  "applicability": {
                    "properties": {
                      "profile": {
                        "const": "STRUCTURE_EFFECTIVE_FROM"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "subjectTime": {
                "properties": {
                  "profile": {
                    "const": "STRUCTURE_EFFECTIVE_INTERVAL"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "assertionBody": {
                "properties": {
                  "applicability": {
                    "properties": {
                      "profile": {
                        "const": "STRUCTURE_EFFECTIVE_INTERVAL"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "subjectTime": {
                "properties": {
                  "profile": {
                    "const": "COMPLIANCE_AS_OF"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "assertionBody": {
                "properties": {
                  "applicability": {
                    "properties": {
                      "profile": {
                        "const": "COMPLIANCE_AS_OF"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "subjectTime": {
                "properties": {
                  "profile": {
                    "const": "COMPLIANCE_EFFECTIVE_FROM"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "assertionBody": {
                "properties": {
                  "applicability": {
                    "properties": {
                      "profile": {
                        "const": "COMPLIANCE_EFFECTIVE_FROM"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "subjectTime": {
                "properties": {
                  "profile": {
                    "const": "COMPLIANCE_EFFECTIVE_INTERVAL"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "assertionBody": {
                "properties": {
                  "applicability": {
                    "properties": {
                      "profile": {
                        "const": "COMPLIANCE_EFFECTIVE_INTERVAL"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "$comment": "Pending-only three-branch carrier, PR #23 sections 5-6 and 8. Unknown and branch-inapplicable fields are absent, never null. Subject/scope selector equality and proof absence/presence, exact body/result equality, temporal order and resolved selectors, authority, offline time trust, committed-prior context and atomicity need separately identified checks; schema validity does not attest them. No event/transaction/authorization/result-digest sidecar fields are admitted."
    }
